# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="AI Codebase Understanding Engine"
DEBUG=false
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Leave blank to use SQLite fallback (development only)
DATABASE_URL=postgresql://user:password@localhost:5432/codebase_engine

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Neo4j (optional — falls back to in-memory NetworkX graph) ───────────────
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=password

# ─── Vector DB (ChromaDB) ─────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=codebase_chunks

# ─── LLM (OpenAI) ─────────────────────────────────────────────────────────────
# Use your own key OR leave blank to use Replit AI Integrations proxy
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# ─── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Storage ─────────────────────────────────────────────────────────────────
REPOS_BASE_DIR=./data/repos
MAX_REPO_SIZE_MB=500

# ─── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
